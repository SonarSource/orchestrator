<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <Pattern>%d{HH:mm:ss.SSS} %-5level %msg%n</Pattern>
    </encoder>
  </appender>

  <appender name="CARGO" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <logger name="CARGO" additivity="false">
    <appender-ref ref="CARGO" />
  </logger>

  <appender name="BUILD_OUTPUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.sonar.orchestrator.BuildOutput" level="INFO" additivity="false">
    <appender-ref ref="BUILD_OUTPUT" />
  </logger>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>